# Copie este arquivo para `.env` e preencha com as credenciais reais
# antes de executar a aplicação em um ambiente privado.

# Ambiente de execução (production|development|testing)
APP_ENV=development

# Configuração do banco de dados MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=registro_ponto
DB_USER=usuario
DB_PASS=senha

# Credenciais SMTP usadas para envio de e-mails de redefinição de senha
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=usuario@example.com
SMTP_PASS=senha-do-email